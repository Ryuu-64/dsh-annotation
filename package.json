{
  "name": "@ryuu-64/dsh-annotation",
  "version": "1.4.10",
  "type": "module",
  "description": "DSH Web selection-annotation plugin (fork of @changfenhuang/dsh-annotation): select assistant text, annotate (optional), and press Enter to send the annotation block with your message — the model replies to each annotation by number, with hoverable chips in the reply.",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "tsconfig.json",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "NOTICE.md"
  ],
  "author": "Ryuu-64",
  "contributors": [
    "changfenhuang (upstream @changfenhuang/dsh-annotation, MIT)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryuu-64/dsh-annotation.git"
  },
  "homepage": "https://github.com/Ryuu-64/dsh-annotation#readme",
  "bugs": {
    "url": "https://github.com/Ryuu-64/dsh-annotation/issues"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "check": "node --check lib/index.js && node --check client.js && npm test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7 || ^4.0.1"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.2": "compatible"
      }
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
